name: Unzip File
on:
  workflow_dispatch: # يسمح لك بتشغيله يدويًا بضغطة زر

jobs:
  unzip:
    runs-on: ubuntu-latest
    permissions:
      contents: write # ضروري للسماح برفع الملفات المفكوكة
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Extract archive
        run: |
          unzip taha_halaqat_app.zip -d output_folder/
          rm taha_halaqat_app.zip

      - name: Commit and push changes
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git add .
          git commit -m "Unzip file via GitHub Actions"
          git push
